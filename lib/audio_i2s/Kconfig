config TROPOSOUND_AUDIO_I2S
	bool "I2S0 master for the TAC5211 (48 kHz, 16-bit stereo)"
	depends on DT_HAS_NORDIC_NRF_I2S_ENABLED
	select NRFX_I2S
	select PINCTRL
	help
	  Clocked from the 12.288 MHz audio PLL, so LRCK is exactly 48 kHz.

config TROPOSOUND_AUDIO_I2S_BLOCK_WORDS
	int "Words per DMA block (one word = one stereo 16-bit frame)"
	default 480
	depends on TROPOSOUND_AUDIO_I2S
	help
	  48 = 1 ms, 480 = 10 ms (one LC3 frame).
