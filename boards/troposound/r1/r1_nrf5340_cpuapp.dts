/dts-v1/;
#include <nordic/nrf5340_cpuapp_qkaa.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "r1_nrf5340_cpuapp-pinctrl.dtsi"

/ {
	model = "Troposound R1 NRF5340 Application";
	compatible = "troposound,r1-nrf5340-cpuapp";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,bt-hci = &bt_hci_ipc0;
		zephyr,sram = &sram0_image;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,sram-secure-partition = &sram0_s;
		zephyr,sram-non-secure-partition = &sram0_ns;
		zephyr,boot-mode = &boot_mode0;
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};

		green_led: led_1 {
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		blue_led: led_2 {
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		ptt_button: button_0 {
			gpios = <&gpio0 23 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "PTT button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	gpio_inputs {
		compatible = "gpio-keys";

		jack_detect: jack_detect {
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
			label = "Headphone jack detect";
			zephyr,code = <INPUT_KEY_1>;
		};

		charge_status: charge_status {
			gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Charge status";
			zephyr,code = <INPUT_KEY_2>;
		};

		fuel_gauge_alert: fuel_gauge_alert {
			gpios = <&gpio0 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Fuel gauge alert";
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	gpio_fwd: nrf-gpio-forwarder {
		compatible = "nordic,nrf-gpio-forwarder";
		status = "okay";

		nrf21540-gpio-if {
			gpios = <&gpio0 30 0>,
				<&gpio0 31 0>,
				<&gpio0 29 0>,
				<&gpio0 4 0>;
		};
	};

	zephyr,user {
		io-channels = <&adc 1>;
		io-channel-names = "volume-pot";
		amp-enable-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
		codec-gpo1-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
		codec-gpi1-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		sw0 = &ptt_button;
		jack-detect = &jack_detect;
		charge-status = &charge_status;
		fuel-gauge-alert = &fuel_gauge_alert;
		fuel-gauge0 = &max17048;
		watchdog0 = &wdt0;
	};
};

&vregmain {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregradio {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&vregh {
	status = "okay";
};

&lfxo {
	load-capacitors = "internal";
	load-capacitance-picofarad = <9>;
};

&hfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <13500>;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <3>;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	tac5211: audio-codec@50 {
		compatible = "ti,tac5211";
		reg = <0x50>;
	};
};

&i2c2 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c2_default>;
	pinctrl-1 = <&i2c2_sleep>;
	pinctrl-names = "default", "sleep";

	max17048: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-1 = <&i2s0_sleep>;
	pinctrl-names = "default", "sleep";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&gpregret1 {
	status = "okay";

	boot_mode0: boot_mode@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

#include <nordic/nrf5340_cpuapp_partition.dtsi>
