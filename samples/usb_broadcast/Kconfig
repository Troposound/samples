menu "USB broadcast sample"

config APP_USB_VID
	hex "USB vendor ID"
	default 0x1915

config APP_USB_PID
	hex "USB product ID"
	default 0x530D
	help
	  Distinct PID so hosts do not reuse cached descriptors from other
	  Troposound firmware.

config APP_USB_PRODUCT
	string "USB product string"
	default "Troposound R1 Broadcast" if BOARD_R1
	default "Troposound H1 Broadcast" if BOARD_H1
	default "Troposound Broadcast"

config BROADCAST_NAME
	string "Broadcast name"
	default "Troposound R1 USB" if BOARD_R1
	default "Troposound H1 USB" if BOARD_H1
	default "Troposound USB"
	help
	  Broadcast_Name AD shown by phones and broadcast assistants (4-32 bytes).

endmenu

source "Kconfig.zephyr"
