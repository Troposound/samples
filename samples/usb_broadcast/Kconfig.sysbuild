# Net core runs ipc_radio (HCI over IPC + SoftDevice Controller with ISO),
# configured by sysbuild/ipc_radio/prj.conf.
config NRF_DEFAULT_IPC_RADIO
	default y

config NETCORE_IPC_RADIO_BT_HCI_IPC
	default y

source "share/sysbuild/Kconfig"
